{
  "name": "learnerscare-grammar",
  "private": true,
  "version": "1.0.0-rc.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsx tools/conversation/status.ts && tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "schema": "tsx tools/gen-schema.ts",
    "validate": "tsx tools/validate-content.ts",
    "test": "vitest run",
    "e2e": "playwright test --trace off",
    "lint": "eslint src tests tools e2e --ext .ts,.tsx",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\"",
    "conversation": "tsx tools/conversation/cli.ts",
    "sample": "tsx tools/sample/build.ts && tsx tools/validate-content.ts content-sample && tsx tools/conversation/cli.ts --unit 900 --content content-sample"
  },
  "dependencies": {
    "framer-motion": "14.12.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@fontsource-variable/nunito": "5.3.0",
    "@fontsource/atkinson-hyperlegible": "5.3.0",
    "@fontsource/fraunces": "5.3.0",
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.5",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "@vitejs/plugin-react": "6.3.0",
    "ajv": "8.20.0",
    "autoprefixer": "10.6.2",
    "eslint": "8.57.1",
    "eslint-plugin-react-hooks": "4.6.2",
    "fake-indexeddb": "6.2.8",
    "jsdom": "25.0.1",
    "playwright": "1.63.0",
    "postcss": "8.5.32",
    "prettier": "3.10.0",
    "tailwindcss": "3.4.19",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.1.0",
    "zod": "4.6.7"
  }
}
