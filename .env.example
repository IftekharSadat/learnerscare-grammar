# --- app build (Vite) ---
# Include draft (unapproved) Talk turns, labelled "Draft". Review builds and tests only.
VITE_TALK_INCLUDE_DRAFTS=false
# Enable the Speech Lab page at #/lab/speech in a production build (always on in `npm run dev`).
VITE_SPEECH_LAB=false
# Show a consent step before the microphone is used (hook for your legal requirements).
VITE_TALK_AGE_GATE=false
# Optional LLM partner lines: URL of your deployed server/proxy.mjs. Leave empty to stay fully scripted.
VITE_LLM_PROXY_URL=
# Optional on-device recogniser (unverified, see docs/DECISIONS.md #18).
VITE_WHISPER_MODULE_URL=
VITE_WHISPER_MODEL=

# --- conversation pipeline ---
# Command that turns text into an audio file for a partner line. {voice} = partner id, {text}, {out} are filled in.
PARTNER_TTS_CMD=

# --- server/proxy.mjs (never in the browser) ---
ANTHROPIC_API_KEY=
ALLOWED_ORIGIN=
PARTNER_MODEL=
PARTNER_EFFORT=
PRICE_IN_PER_MTOK=
PRICE_OUT_PER_MTOK=
DAILY_USD_CAP=2
