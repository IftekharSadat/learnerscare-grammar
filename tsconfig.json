{
  "compilerOptions": {
    "target": "ES2020", "lib": ["ES2021", "DOM", "DOM.Iterable"], "module": "ESNext", "moduleResolution": "bundler",
    "jsx": "react-jsx", "strict": true, "noUnusedLocals": true, "noUnusedParameters": true, "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true, "resolveJsonModule": true, "isolatedModules": true, "noEmit": true, "allowImportingTsExtensions": false,
    "baseUrl": ".", "paths": { "@/*": ["src/*"] }, "types": ["vite/client", "vite-plugin-pwa/client"]
  },
  "include": ["src", "tests", "tools", "vite.config.ts", "playwright.config.ts", "e2e"]
}
